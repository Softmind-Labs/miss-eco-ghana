{
  "functionUrl": "https://eisqaarydwtsarlghdjs.supabase.co/functions/v1/register",
  "maxPhotoBytes": 10485760,
  "tiers": [
    {
      "id": "early",
      "label": "Early Bird",
      "ghs": 200,
      "usd": 50,
      "start": "2026-08-15",
      "end": "2026-09-30"
    },
    {
      "id": "late",
      "label": "Late Registration",
      "ghs": 300,
      "usd": 75,
      "start": "2026-10-01",
      "end": "2026-10-31"
    }
  ],
  "fields": [
    { "name": "fullName",         "label": "Full name",        "type": "text",     "required": true, "autocomplete": "name" },
    { "name": "email",            "label": "Email address",    "type": "email",    "required": true, "autocomplete": "email" },
    { "name": "phone",            "label": "Phone number",     "type": "tel",      "required": true, "autocomplete": "tel" },
    { "name": "instagramHandle",  "label": "Instagram handle", "type": "text",     "required": true, "placeholder": "@yourhandle" },
    { "name": "tiktokHandle",     "label": "TikTok handle",    "type": "text",     "required": true, "placeholder": "@yourhandle" },
    {
      "name": "heardFrom",
      "label": "How did you hear about this competition?",
      "type": "radio",
      "required": true,
      "choices": ["Instagram", "Tiktok", "A friend", "Other"],
      "other": true
    },
    { "name": "age", "label": "Age", "type": "number", "required": true, "min": 16, "max": 60 },
    {
      "name": "environmentalView",
      "label": "What are some environmental problems Ghana is facing, and what recommendations do you have for these problems?",
      "type": "textarea",
      "required": true,
      "rows": 6
    },
    {
      "name": "contestedBefore",
      "label": "Have you ever contested in any pageant?",
      "type": "radio",
      "required": true,
      "choices": ["Yes", "No", "Maybe"]
    },
    {
      "name": "hasPassport",
      "label": "Do you have a valid passport?",
      "type": "radio",
      "required": true,
      "choices": ["Yes", "No", "Other"],
      "other": true
    },
    {
      "name": "standoutQualities",
      "label": "What 3 qualities do you have that stand out for you?",
      "type": "textarea",
      "required": true,
      "rows": 4
    },
    {
      "name": "hasSupport",
      "label": "Do you have the necessary support you would need for this competition?",
      "type": "radio",
      "required": true,
      "choices": ["Yes", "No", "Maybe"]
    },
    {
      "name": "bikiniComfort",
      "label": "Are you okay with bikini shoots?",
      "type": "radio",
      "required": false,
      "choices": ["Yes", "No", "Maybe"]
    },
    {
      "name": "occupation",
      "label": "What do you do?",
      "type": "radio",
      "required": true,
      "choices": ["Student", "Worker", "Entrepreneur", "Other"],
      "other": true
    },
    {
      "name": "photo",
      "label": "Upload a picture of yourself",
      "type": "file",
      "required": true,
      "accept": "image/jpeg,image/png,image/webp,image/heic",
      "hint": "One image, JPG / PNG / WEBP / HEIC, max 10 MB."
    },
    {
      "name": "hasWhatItTakes",
      "label": "Do you have what it takes to become the next Miss Eco Ghana 2027?",
      "type": "radio",
      "required": true,
      "choices": ["Yes", "No", "Maybe", "Other"],
      "other": true
    }
  ]
}
